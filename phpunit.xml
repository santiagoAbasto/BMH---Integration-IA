<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Suite del asesor. Se corre sola con: phpunit testsuite BMH -->
        <testsuite name="BMH">
            <directory>tests/Feature/Bmh</directory>
        </testsuite>
    </testsuites>
    <!-- restrictDeprecations: sólo importan las deprecaciones que salgan de app/.
         Las del vendor sobre PHP 8.5 son ruido conocido. Ver tests/bootstrap.php. -->
    <source restrictDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Conexión por defecto: base DESECHABLE y usuario sin permisos de
             escritura sobre la copia legacy.
             Los tests heredados de Breeze usan RefreshDatabase, que hace
             migrate:fresh sobre esta conexión. Apuntarla a bmh_legacy borraría
             el catálogo; el usuario bmh_test sólo tiene SELECT ahí, así que
             ni un error de configuración puede volver a romperlo. -->
        <env name="DB_DATABASE" value="bmh_app_test"/>
        <env name="DB_USERNAME" value="bmh_test"/>
        <env name="DB_PASSWORD" value="bmh_test_local"/>
        <env name="DB_LEGACY_USERNAME" value="bmh_reader"/>
        <env name="DB_LEGACY_PASSWORD" value="bmh_reader_local"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- El asesor usa su propia base; los tests corren contra una copia. -->
        <env name="DB_AI_DATABASE" value="bmh_ai_test"/>
        <env name="DB_AI_USERNAME" value="bmh_test"/>
        <env name="DB_AI_PASSWORD" value="bmh_test_local"/>
        <!-- La base legacy se lee tal cual: es de sólo lectura y los tests
             verifican el mapeo contra datos reales, no contra fixtures. -->
        <env name="DB_LEGACY_DATABASE" value="bmh_legacy"/>
        <env name="AI_PROVIDER" value="mock"/>
        <env name="AI_DEBUG" value="true"/>
        <env name="BMH_STOCK_SEMANTICS_VERIFIED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
