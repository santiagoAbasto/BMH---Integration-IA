APP_NAME="BMH - Asistente IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base principal del sitio legacy. Nunca usar credenciales reales en Git.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bmh_legacy
DB_USERNAME=bmh_app
DB_PASSWORD=

# Lectura aislada del catálogo legacy para el asesor.
DB_LEGACY_DATABASE=bmh_legacy
DB_LEGACY_USERNAME=bmh_reader
DB_LEGACY_PASSWORD=

# Base propia de conversaciones, auditoría e índice de búsqueda IA.
DB_AI_DATABASE=bmh_ai
DB_AI_USERNAME=bmh_app
DB_AI_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@bmh.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Proveedor: mock, gemini u openai. mock permite desarrollar sin API key.
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_API_KEY=
AI_TIMEOUT=30
AI_ENABLED=true
AI_VISION_ENABLED=true
AI_DEBUG=false
AI_FALLBACK_ENABLED=false
AI_MAX_TOKENS_PER_CONVO=200000

AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gemini-2.5-flash
AI_VISION_MODEL=gemini-2.5-flash
AI_FAST_MODEL=gemini-2.5-flash-lite
AI_EMBEDDING_MODEL=text-embedding-004

CUSTOMER_HISTORY_ENABLED=true
SEMANTIC_SEARCH_ENABLED=false

# Mantener false hasta que BMH confirme qué representa productos.stock.
BMH_STOCK_SEMANTICS_VERIFIED=false
